

<%= form_with model: @user ,url: registrations_path do |f|%>
    <div>
     <%= f.label :email_address%>
     <%= f.email_field :email_address%>
    </div>

   <div>
     <%= f.label :password%>
     <%= f.password_field :password%>
     </div>

     <div>
     <%= f.label :password_confirmation%>
     <%= f.password_field :password_confirmation%>
     </div>

      <%= f.submit %>

<%end%>